<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UrlShortener.Application\UrlShortener.Application.csproj" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\agents\prompts\*.md" Link="Prompts\%(Filename)%(Extension)">
      <LogicalName>UrlShortener.Agents.Prompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
